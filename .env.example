# Copy only the settings you need into an ignored `.env`, then export them in
# your shell or pass that file to your process manager. Keep every real secret
# out of this example and out of Git.

# HEAE_DATABASE_PATH=/absolute/path/to/local/desk.db
# HEAE_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:8000
# HEAE_ADMIN_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:8000

# Prefer the Credentials page and OS keychain. This read-only environment
# fallback is useful for CI or disposable development shells.
# HEAE_FRED_API_KEY=

# Required only for the manual SEC 8-K Item 2.02 results-filing fetch. SEC
# asks automated clients to declare an application/company name and a real
# contact address; do not commit a personal address here.
# HEAE_SEC_USER_AGENT=Hierarchical Exposure Allocation Engine contact@example.com
